<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="16dp">

    <!-- Spacer for top padding -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="24dp" />

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- App Logo -->
        <ImageView
            android:id="@+id/app_logo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/avatar_background" />

        <!-- App Title -->
        <TextView
            android:id="@+id/app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_title"
            android:textSize="24sp"
            style="@style/TextHeading"
            android:textColor="@color/text_primary"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginTop="16dp"
            android:textAlignment="center" />

        <!-- App Subtitle -->
        <TextView
            android:id="@+id/app_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_subtitle"
            android:textSize="15sp"
            style="@style/TextCaption"
            android:textColor="@color/text_secondary"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginTop="8dp"
            android:textAlignment="center" />

    </LinearLayout>

    <!-- Spacer -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="32dp" />

    <!-- Form Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Email Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/email_input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxBackgroundColor="@color/surface"
            app:boxStrokeColor="@color/text_primary"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:boxStrokeErrorColor="@color/error"
            app:hintTextColor="@color/text_secondary"
            app:helperTextTextColor="@color/error"
            android:minHeight="48dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/email_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/email_hint"
                android:inputType="textEmailAddress"
                android:textSize="15sp"
                style="@style/TextButton"
                android:textColor="@color/text_primary"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:autofillHints="emailAddress" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/password_input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxBackgroundColor="@color/surface"
            app:boxStrokeColor="@color/text_primary"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:boxStrokeErrorColor="@color/error"
            app:hintTextColor="@color/text_secondary"
            app:helperTextTextColor="@color/error"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/text_secondary"
            android:minHeight="48dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/password_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/password_hint"
                android:inputType="textPassword"
                android:textSize="15sp"
                style="@style/TextButton"
                android:textColor="@color/text_primary"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:autofillHints="password" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Auxiliary Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <!-- Remember Me Checkbox -->
            <CheckBox
                android:id="@+id/remember_me_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/remember_me"
                android:textSize="12sp"
                style="@style/TextCaption"
                android:textColor="@color/text_secondary"
                android:buttonTint="@color/colorPrimary" />

            <!-- Forgot Password Link -->
            <TextView
                android:id="@+id/forgot_password_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forgot_password"
                android:textSize="12sp"
                style="@style/TextCaption"
                android:textColor="@color/info"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp" />

        </LinearLayout>

        <!-- Security Info Box (Optional) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:background="@color/cardview_light_background"
            android:padding="12dp"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/security_info_icon"
                android:src="@drawable/ic_lock"
                app:tint="@color/colorAccent"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/security_info_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/security_info"
                android:textSize="12sp"
                style="@style/ButtonStyle.Secondary"
                android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.4" />

        </LinearLayout>

        <!-- Primary Login Button -->
        <Button
            android:id="@+id/login_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/login_button"
            android:textSize="15sp"
            style="@style/ButtonStyle.Primary"
            android:textColor="@android:color/white"
            android:layout_marginBottom="12dp"
            android:textAllCaps="false" />

        <!-- Secondary Create Account Button -->
        <Button
            android:id="@+id/create_account_button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/create_account_button"
            android:textSize="15sp"
            style="@style/ButtonStyle.Primary"
            android:textColor="@android:color/white"
            android:textAllCaps="false" />

    </LinearLayout>

    <!-- Sign Up Link -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Don't have an account? "
            style="@style/TextBody"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tvCreateAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign Up"
            style="@style/TextBody"
            android:textColor="@color/colorPrimary"
            android:textStyle="bold" />
    </LinearLayout>


    <!-- Spacer to push FAB area -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>